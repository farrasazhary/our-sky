# Server Environment Variables
PORT=5000
NODE_ENV=development

# MySQL Database Connection (Prisma)
# Replace root:password@localhost:3306/oursky_db with your local MySQL credentials
DATABASE_URL="mysql://root:password@localhost:3306/oursky_db"

# JWT Authentication Secret & Lifetime
JWT_SECRET="oursky_super_secret_jwt_key_2026"
JWT_EXPIRES_IN="7d"

# Local File Storage Directory Path
STORAGE_PATH="./storage"
